# Passphrase untuk masuk ke Studio CMS.
STUDIO_ADMIN_PASSPHRASE=studio-2026

# Kunci HMAC untuk cookie sesi admin. Wajib minimal 16 karakter.
STUDIO_SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-16-karakter

# Label identitas yang tampil pada bilah studio.
STUDIO_ADMIN_LABEL=admin@msfr.dev

# Lokasi berkas basis data JSON. Default: .data/portfolio.json
# PORTFOLIO_DB_PATH=.data/portfolio.json

# Folder penyimpanan berkas gambar unggahan. Default: .data/media
# MEDIA_DIR=.data/media
