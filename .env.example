# Isi dengan rahasia acak (minimal 16 karakter) sebelum deploy production.
STUDIO_ADMIN_PASSPHRASE=

# Kunci HMAC acak (minimal 32 karakter) sebelum deploy production.
STUDIO_SESSION_SECRET=

# URL project Supabase (production wajib).
SUPABASE_URL=

# Service role key Supabase (server-only, jangan pernah gunakan NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Label identitas yang tampil pada bilah studio.
STUDIO_ADMIN_LABEL=admin@msfr.dev

# Mode lokal tanpa Supabase memakai penyimpanan JSON.
# PORTFOLIO_DB_PATH=.data/portfolio.json

# Mode lokal tanpa Supabase memakai folder media lokal.
# MEDIA_DIR=.data/media
